# "subscription" uses Claude Code (signed in with your Claude plan); "api" uses ANTHROPIC_API_KEY.
JARVIS_BACKEND=subscription
# Only needed for JARVIS_BACKEND=api
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: a better-sounding voice. Without it, Windows' built-in voice is used.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
# Microphone: a device number or part of its name (run mic_test.py to see them). Blank = Windows default.
JARVIS_MIC=
# Raise if background noise triggers recording / false wakes; lower if Jarvis doesn't hear you.
JARVIS_SPEECH_THRESHOLD=0.015
JARVIS_WAKE_THRESHOLD=0.5
# Seconds to keep listening for a follow-up after a reply (0 = always need "hey Jarvis", -1 = until "that's all")
JARVIS_FOLLOWUP_SECONDS=10
# Folders Jarvis may use without asking, separated by ';' (blank = Desktop, Documents, Downloads, ...)
JARVIS_FILE_FOLDERS=
# Gmail: your address and an app password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Discord: a channel webhook URL (Channel settings > Integrations > Webhooks) and/or a bot token
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
# Home city for weather when you do not name one, e.g. "Boston, MA"; and fahrenheit or celsius
JARVIS_LOCATION=
JARVIS_TEMP_UNIT=fahrenheit
# Talking over Jarvis: "speech" (any speech stops it), "wake" (only "hey Jarvis"), or "off"
JARVIS_INTERRUPT=speech
# Phone control: a bot token from Telegram's @BotFather, and your own Telegram user ID (the bot tells you it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Send a screenshot after phone tasks that change the screen (on/off)
TELEGRAM_AUTO_SCREENSHOT=on
# Spotify (play specific music): Client ID of your app at developer.spotify.com; then run connect.py spotify
SPOTIFY_CLIENT_ID=
# Google Calendar: OAuth "Desktop app" client from Google Cloud Console; then run connect.py google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Speed: pause (seconds) that means you've finished talking; Whisper beam size (1 = fastest)
JARVIS_END_OF_SPEECH_S=0.8
JARVIS_STT_BEAM=1
# Only answer your voice once enroll_voice.py has been run (on/off)
JARVIS_VOICE_LOCK=on
# Port for the agent dashboard (opened with a secret link: say "open the dashboard")
JARVIS_DASHBOARD_PORT=8765
# To open the dashboard from your phone anywhere: run `tailscale serve --bg 8765` and put the https address it
# shows here (e.g. https://my-pc.tail1234.ts.net). Telegram's /dashboard then sends you the link.
JARVIS_DASHBOARD_URL=
# To open the dashboard from ANY browser (not just your Tailscale devices): set a long password here and run
# `tailscale funnel --bg 8765` instead of `tailscale serve`. Visitors then get a sign-in page.
JARVIS_DASHBOARD_PASSWORD=
# The dashboard's Usage tab reads your plan's 5-hour and weekly usage with Claude Code's own login (only sent to
# Anthropic). Set to off to hide it.
JARVIS_PLAN_USAGE=on
# Agent team on Telegram: a second bot from @BotFather. Add it to a group with Topics on, make it an admin that can
# manage topics, and send /setup there; each agent then gets its own topic. (TEAM_TELEGRAM_CHAT_ID is optional.)
TEAM_TELEGRAM_BOT_TOKEN=
TEAM_TELEGRAM_CHAT_ID=
# Port for the agent team service on this PC (blank = any free port)
JARVIS_TEAM_PORT=
# Coder agents (repositories in code_repos.json): a GitHub fine-grained token with Contents and Pull requests
# read/write on those repositories, so they can push branches and open pull requests and the Reviewer can merge.
GITHUB_TOKEN=
# Merging approved team pull requests into main: "auto" (the Reviewer merges) or "ask" (Yes/No on your phone first)
JARVIS_AGENT_MERGE=auto
# Trade Analyst (standing agent): reads your TradeLog trades, signed in as you (read only). The URL and anon key are
# the same VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY your TradeLog app uses; email and password are your login.
TRADELOG_SUPABASE_URL=
TRADELOG_SUPABASE_ANON_KEY=
TRADELOG_EMAIL=
TRADELOG_PASSWORD=
# Job Hunter (standing agent), optional: a free Adzuna key (developer.adzuna.com) for broad job search. Without it,
# it still searches remote boards, companies' own job boards and the web. Country: us, gb, ca, ...
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# Trade Analyst and Portfolio Advisor, optional: a free Alpha Vantage key (alphavantage.co/support/#api-key)
# for market news with sentiment, technical indicators and company fundamentals (about 25 calls a day free).
ALPHAVANTAGE_API_KEY=
